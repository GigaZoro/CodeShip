# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
# GitHub's and Expo's GraphQL schemas and the operations graphqlgen writes from them.
packages/source-control-github/schema/** linguist-generated
apps/server/schema/** linguist-generated
**/*.graphql.ts linguist-generated
# Rebases and merges keep release notes newest first; `vp i` configures the driver.
docs/release-notes.md merge=release-notes
# Keep checksum-pinned Rust and Cargo patches byte-for-byte, including diff context lines.
docs/operations/codex-metadata/*.patch whitespace=-blank-at-eol
docs/operations/codex-metadata/*.diff whitespace=-blank-at-eol
