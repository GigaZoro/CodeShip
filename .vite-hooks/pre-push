# A push to main needs the landing turn, so main cannot move under the checked tree (landing-turn.cjs).
# It also runs fork release preflight's notes check: one that fails there blocks every later release.
refs=$(cat)
printf '%s\n' "$refs" | node .github/scripts/landing-turn.cjs verify "$2" || exit 1
printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_sha" in *[!0]*) base="$remote_sha" ;; *) base="" ;; esac
  node .github/scripts/release-notes.cjs check "$base" "$local_sha" || exit 1
done
