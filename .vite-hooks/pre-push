#!/bin/sh
# core.hooksPath is this folder (machine-config.json), so git runs this file itself: no install needed.
# A push to main needs the landing turn, so main cannot move under the checked tree (landing-turn.cjs), and a
# `vp run check:changed` pass for the exact tree it pushes. It also runs fork release preflight's notes check:
# one that fails there blocks every later release.
refs=$(cat)
# Each line read from the right: git gives the local ref as typed, which may hold spaces, and `verify` refuses a line
# it cannot read this way.
to_main=$(printf '%s\n' "$refs" | while IFS= read -r line; do
  rest=${line% *}
  [ "${rest##* }" != refs/heads/main ] || printf '%s\n' "$line"
done)
# A push that moves only the landing lease, as when a lander gives the turn back, has nothing to verify, so it must
# not depend on this working tree's scripts loading.
[ -n "$to_main" ] || exit 0
printf '%s\n' "$refs" | node .github/scripts/landing-turn.cjs verify "$2" || exit 1
printf '%s\n' "$to_main" | while IFS= read -r line; do
  remote_sha=${line##* }
  line=${line% *}
  line=${line% *}
  local_sha=${line##* }
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_sha" in *[!0]*) base="$remote_sha" ;; *) base="" ;; esac
  node .github/scripts/release-notes.cjs check "$base" "$local_sha" || exit 1
  node .github/scripts/check-changed-receipt.cjs verify "$local_sha" "$base" || exit 1
done
