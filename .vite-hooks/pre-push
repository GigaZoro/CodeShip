# A push to main runs fork release preflight's notes check first: one that fails there blocks every later release.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_sha" in *[!0]*) base="$remote_sha" ;; *) base="" ;; esac
  node .github/scripts/release-notes.cjs check "$base" "$local_sha"
done
